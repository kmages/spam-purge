{
  "expo": {
    "name": "SPAM Purge",
    "slug": "spam-purge",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "spampurge",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.herokuapp.spam-cleaner",
      "buildNumber": "7",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "spamcleaner.herokuapp.com.spamtrashautodeletegmail",
      "versionCode": 20000007,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "kmages",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94db5aab-e85d-49cd-b8b1-2c4aea536b59"
      }
    },
    "icon": "./assets/icon.png"
  }
}
