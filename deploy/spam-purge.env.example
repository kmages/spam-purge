# Copy this to /etc/spam-purge.env on the VM and fill in real values.
# Keep this file private (chmod 600) — it holds secrets.

# Postgres connection string for the VM's database
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/spam_purge

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts stored Google refresh tokens. 32 random bytes, base64: `openssl rand -base64 32`
# The server refuses to start without it. Back it up: losing it means every user must reconnect Gmail.
TOKEN_ENC_KEY=change-me

# Public hostname, used for the OAuth callback URL and CORS
DOMAIN=spampurge.example.com

# Where mobile sign-in sends users back to the app (default spampurge://auth)
# MOBILE_REDIRECT_URI=spampurge://auth

# Google OAuth client credentials (from Google Cloud Console)
GOOGLE_OAUTH_CID=your-google-client-id
GOOGLE_OAUTH_CSEC=your-google-client-secret

# Runtime config — leave these as-is for self-hosting
NODE_ENV=production
PORT=8080
SERVE_STATIC=true
