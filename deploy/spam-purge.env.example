# Copy this to /etc/spam-purge.env on the VM and fill in real values.
# Keep this file private (chmod 600) — it holds secrets.

# Postgres connection string for the VM's database
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/spam_purge

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth client credentials (from Google Cloud Console)
GOOGLE_OAUTH_CID=your-google-client-id
GOOGLE_OAUTH_CSEC=your-google-client-secret

# Runtime config — leave these as-is for self-hosting
NODE_ENV=production
PORT=8080
SERVE_STATIC=true
